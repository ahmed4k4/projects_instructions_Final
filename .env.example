# ---------------------------------------------------------------------------
# RIGPILOT — environment
# Copy this file to `.env.local`. Never commit `.env.local`.
#
# The AI key has NO VITE_ prefix on purpose: Vite inlines every VITE_* variable
# into the browser bundle, which would publish the key to every visitor. This
# key is read only on the server — the Vercel Serverless Function
# (`api/ai/[...path].ts`) in production and the same handler in the Vite dev
# middleware locally (see `src/server/geminiProxy.ts`). Never add VITE_GEMINI_API_KEY.
#
# On Vercel: Project → Settings → Environment Variables → add GEMINI_API_KEY for
# Production, Preview and Development, then redeploy. A missing key shows up as
# `{ "gemini": false }` from GET /api/ai/config and a 503 from the proxy.
# ---------------------------------------------------------------------------

# === Server-only credentials (Vercel Function + local Vite proxy) ===========
# URL and anon key are used by guest-IP and optional account quota RPCs. The anon key is public by design.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional server-only salt used to hash guest IPs before quota storage.
# Set a long random value in Vercel; do not expose it with a VITE_ prefix.
AI_RATE_LIMIT_SALT=

# === Google AI Studio (Gemini) =============================================
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Displayed in deployment diagnostics. Actual model selection and fallback
# are controlled by src/services/ai/models.ts. Interactive default: Gemini 3.5 Flash-Lite with MINIMAL thinking.
GEMINI_MODEL=gemini-3.5-flash-lite

# === Public app URL ========================================================
# Base URL used for share links and auth redirects.
# Inlined into the bundle (VITE_*) — never put a secret here.
# Leave empty locally (the current origin is used); set it to the deployed
# origin, e.g. https://nexus.example.com, after deploying.
VITE_APP_URL=

# === Supabase browser config ===============================================
# Public project URL + anon key. Use the same project as SUPABASE_URL above.
# Username/password auth and cloud saves use these. Guest AI also works without an account.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only: required for username/password account creation (never use VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=
AUTH_RATE_LIMIT_SALT=

# Optional: key from a DIFFERENT Google AI Studio project; tried only after primary HTTP 429.
GEMINI_API_KEY_FALLBACK=
