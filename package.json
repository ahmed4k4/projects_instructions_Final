{
  "name": "nexus-pc-builder",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "description": "AI-Powered PC Builder - design, optimize and compare custom PC builds with Google Gemini AI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json,md}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "audit:all": "node scripts/audit-all.mjs",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "verify:spa": "node scripts/verify-spa-routing.mjs",
    "verify:images": "node scripts/verify-images.mjs",
    "verify:ai-route": "node scripts/verify-ai-function.mjs",
    "verify:nav": "node scripts/test-mobile-nav.mjs",
    "crawl": "node scripts/crawl-retailers.mjs",
    "crawl:sigma": "python scripts/sigma_worker.py",
    "verify:coverage": "node scripts/verify-listing-coverage.mjs",
    "check:orphans": "node scripts/check-orphans.mjs",
    "check:exports": "node scripts/check-unused-exports.mjs",
    "verify:retailers": "node scripts/verify-retailers.mjs",
    "perf": "node scripts/measure-perf.mjs",
    "audit:unused": "node scripts/audit-unused.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "verify:ai": "node scripts/verify-function-calling-loop.mjs",
    "verify:build": "node scripts/verify-build-generation.mjs",
    "qa:page": "node scripts/qa-page.mjs",
    "functions:serve": "supabase functions serve gemini-proxy --env-file supabase/.env.local",
    "functions:deploy": "supabase functions deploy gemini-proxy",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "verify:ai-speed": "node scripts/verify-ai-performance.mjs",
    "verify:guest-auth": "node scripts/verify-guest-auth.mjs",
    "verify:build-loop": "node --experimental-strip-types scripts/verify-build-agent-regressions.mjs",
    "verify:builder-ui": "node scripts/verify-builder-ui.mjs",
    "verify:retailer-stock": "node --experimental-strip-types scripts/verify-retailer-stock-parser.mjs",
    "verify:retailer-freshness": "node --experimental-strip-types scripts/verify-retailer-stock-freshness.mjs",
    "verify:shortlist": "node --experimental-strip-types scripts/verify-budget-shortlist.mjs",
    "verify:smart-builder": "node --experimental-strip-types scripts/verify-build-agent-regressions.mjs && node scripts/verify-ai-performance.mjs && node scripts/verify-builder-ui.mjs && node --experimental-strip-types scripts/verify-budget-shortlist.mjs && node --experimental-strip-types scripts/verify-typescript-and-gemini-quota.mjs",
    "verify:gemini-quota": "node --experimental-strip-types scripts/verify-typescript-and-gemini-quota.mjs",
    "verify:signup-resilience": "node scripts/verify-signup-resilience.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.11",
    "@types/three": "^0.169.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.15.0",
    "i18next": "^26.5.12",
    "i18next-browser-languagedetector": "^8.2.4",
    "immer": "^10.1.1",
    "lucide-react": "^0.469.0",
    "lz-string": "^1.5.0",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.169.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
